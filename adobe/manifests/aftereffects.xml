<?xml version="1.0" encoding="UTF-8"?>
<!-- ODDIN plugin for aftereffects. Installed by ODDIN (lib/adobe-install.mjs). Keep ASCII only. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.oddin.aftereffects" ExtensionBundleVersion="@VERSION@" ExtensionBundleName="ODDIN" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.oddin.aftereffects.panel" Version="@VERSION@"/>
    <Extension Id="com.oddin.aftereffects.worker" Version="@VERSION@"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[16.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.oddin.aftereffects.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel.html</MainPath>
          <ScriptPath>./host/oddin.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>ODDIN</Menu>
          <Geometry>
            <Size><Height>260</Height><Width>240</Width></Size>
            <MinSize><Height>120</Height><Width>140</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.oddin.aftereffects.worker">
      <DispatchInfo>
        <Resources>
          <MainPath>./worker.html</MainPath>
          <ScriptPath>./host/oddin.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
